{
  "name": "commonwealth-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "images:populate": "node scripts/fetch-country-images.mjs",
    "images:validate": "node scripts/validate-country-hero-descriptions.mjs",
    "images:curate-once": "npm run images:populate && npm run images:validate",
    "generate:research-links": "node scripts/generate-country-research-links.mjs",
    "refresh:familysearch-collections": "node scripts/refresh-familysearch-collections.mjs",
    "generate:commonwealth-metadata": "node scripts/generate-commonwealth-metadata.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "hls.js": "^1.6.16",
    "html-to-image": "^1.11.13",
    "jimp": "^0.16.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^5.24.0",
    "multer": "^2.2.0",
    "plyr": "^3.8.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.1.1",
    "sharp": "^0.35.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.71.0",
    "puppeteer": "^25.3.0",
    "vite": "^8.1.1"
  }
}
