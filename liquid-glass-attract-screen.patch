+/* Liquid-glass specular rim: a soft highlight that slowly orbits the pill's
+   edge, like light catching the curvature of real glass. Pure CSS/GPU. */
+.explore-cta-rim {
+  position: absolute;
+  inset: 0;
+  border-radius: 999px;
+  padding: 1px;
+  background: conic-gradient(
+    from 0deg,
+    rgba(255, 255, 255, 0) 0%,
+    rgba(255, 255, 255, 0.95) 6%,
+    rgba(255, 255, 255, 0) 20%,
+    rgba(255, 255, 255, 0) 52%,
+    rgba(204, 228, 255, 0.6) 61%,
+    rgba(255, 255, 255, 0) 75%,
+    rgba(255, 255, 255, 0) 100%
+  );
+  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
+  -webkit-mask-composite: xor;
+  mask-composite: exclude;
+  pointer-events: none;
+  z-index: 1;
+  opacity: 0;
+  transition: opacity 420ms ease;
+}
+
+.explore-cta-button.explore-cta-button-attract .explore-cta-rim {
+  opacity: 1;
+  animation: rimRotate 7s linear infinite;
+}
+
+@keyframes rimRotate {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+/* Touch ripple — the acknowledgment that glass is a physical surface
+   reacting to contact. Spawned imperatively at the touch point and removed
+   once its single animation cycle finishes. */
+.glass-ripple {
+  position: absolute;
+  width: 12px;
+  height: 12px;
+  margin-left: -6px;
+  margin-top: -6px;
+  border-radius: 50%;
+  background: radial-gradient(circle, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.4) 42%, rgba(255, 255, 255, 0) 72%);
+  pointer-events: none;
+  z-index: 3;
+  animation: glassRippleExpand 640ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
+}
+
+@keyframes glassRippleExpand {
+  0% {
+    transform: scale(0.4);
+    opacity: 0.9;
+  }
+  70% {
+    opacity: 0.45;
+  }
+  100% {
+    transform: scale(15);
+    opacity: 0;
+  }
+}
+
 .explore-cta-button {
   position: relative;
 }
